# Copy to .env (git-ignored) before running docker compose.

# PostgreSQL
DB_USER=postgres
DB_PW=postgres
DB_NAME=postgres

# Kestrel dev certificate password.
# Must match the password baked into src/Service/generate-cert.sh (default: P@ssw0rd!),
# no surrounding single or double quotes.
CERT_PASSWORD=P@ssw0rd!

# pgAdmin login (http://localhost:8080)
PGADMIN_EMAIL=admin@example.com
PGADMIN_PASSWORD=admin
