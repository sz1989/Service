{
    // Use IntelliSense to learn about possible attributes.
    // Hover to view descriptions of existing attributes.
    // For more information, visit: https://go.microsoft.com/fwlink/?linkid=830387
    "version": "0.2.0",
    "configurations": [
        {
            "name": ".NET Launch (web)",
            "type": "coreclr",
            "request": "launch",
            "preLaunchTask": "build",
            "program": "${workspaceFolder}/src/Service/bin/Debug/net10.0/Service.dll",
            "args": [],
            "cwd": "${workspaceFolder}/src/Service",
            "stopAtEntry": false,
            "console": "integratedTerminal",
            "serverReadyAction": {
                "pattern": "Now listening on:(.*)",
                "action": "openExternally",
                "uriFormat": "%s"
            }
        },
        {
            "name": "React: Chrome",
            "type": "pwa-chrome",
            "request": "launch",
            "url": "http://localhost:3000",
            "webRoot": "${workspaceFolder}/ui/src",
            "sourceMaps": true
        },
        {
            "name": ".NET Attach",
            "type": "coreclr",
            "request": "attach",
            "processId": "${command:pickProcess}"
        }
    ],
    "compounds": [
        {
            "name": "React + .NET",
            "configurations": [
                "React: Chrome",
                ".NET Launch (web)"
            ]
        }
    ]
}