meta {
  name: Update Missing Person (404)
  type: http
  seq: 6
}

put {
  url: {{baseUrl}}/v2/Person
  body: json
  auth: inherit
}

body:json {
  {
    "id": 999999,
    "name": "Does Not Exist",
    "dateOfBirth": "1990-01-15",
    "managerId": null,
    "salary": 1
  }
}

assert {
  res.status: eq 404
}
